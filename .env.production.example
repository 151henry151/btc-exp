# Copy to .env.production and set SECRET_KEY_BASE (see mix phx.gen.secret).
# Load these variables in your process manager (e.g. systemd EnvironmentFile) when starting the app.
MIX_ENV=prod
PHX_SERVER=true
PORT=40174
PHX_HOST=hromp.com
PHX_PATH=btcexp

# Chain backend: "esplora" (default) uses ESPLORA_BASE_URL only.
# "rpc" requires BITCOIN_RPC_* and FULCRUM_* (FulcrumClient starts only in rpc mode).
# DATA_SOURCE=esplora

# Optional: Esplora-compatible API when DATA_SOURCE=esplora (default https://blockstream.info/api)
# ESPLORA_BASE_URL=https://blockstream.info/api

# Optional: cache dashboard Esplora responses (ms). Prod defaults to 45000 if unset; use 0 to disable.
# ESPLORA_CACHE_TTL_MS=45000

# Optional: minimum ms between finishing one Esplora HTTP request and starting the next (serialized).
# Prod defaults to 250 if unset (helps avoid public API HTTP 429); use 0 to disable back-to-back spacing.
# ESPLORA_MIN_REQUEST_INTERVAL_MS=250

# Bitcoin Core JSON-RPC (required when DATA_SOURCE=rpc)
# BITCOIN_RPC_URL=http://127.0.0.1:8332
# BITCOIN_RPC_USER=
# BITCOIN_RPC_PASS=

# Fulcrum Electrum TCP/TLS (required when DATA_SOURCE=rpc)
# FULCRUM_HOST=127.0.0.1
# FULCRUM_PORT=50001
# FULCRUM_SSL=false

SECRET_KEY_BASE=
